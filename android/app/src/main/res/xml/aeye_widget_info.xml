<?xml version="1.0" encoding="utf-8"?>
<!-- Medium (4×2) by default, resizable up to Large (4×4) — the two WidgetKit families iOS offers.
     The widget only reads the snapshot the app last wrote; the app refreshes it on every
     refresh, and the system asks again every 30 minutes (its minimum). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="250dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="520dp"
    android:maxResizeHeight="440dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_loading"
    android:previewImage="@drawable/widget_preview"
    android:widgetCategory="home_screen" />
