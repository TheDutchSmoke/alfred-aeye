<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up and transfer the preferences and the last snapshot, never the encrypted
     credentials — kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly, on iOS. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="aeye_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="aeye_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
